Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", 
    RowBox[{"\[Omega]_", ",", " ", "\[Omega]0_", ",", " ", "\[Gamma]_"}], 
    "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{
     SuperscriptBox["\[Omega]0", "2"], "-", 
     SuperscriptBox["\[Omega]", "2"]}], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Omega]0", "2"], "-", 
        SuperscriptBox["\[Omega]", "2"]}], ")"}], "2"], "+", 
     RowBox[{
      SuperscriptBox["\[Omega]", "2"], 
      SuperscriptBox["\[Gamma]", "2"]}]}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", 
    RowBox[{"\[Omega]_", ",", " ", "\[Omega]0_", ",", " ", "\[Gamma]_"}], 
    "]"}], " ", ":=", " ", 
   FractionBox[
    RowBox[{"\[Omega]", " ", "\[Gamma]"}], 
    RowBox[{
     SuperscriptBox[
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["\[Omega]0", "2"], "-", 
        SuperscriptBox["\[Omega]", "2"]}], ")"}], "2"], "+", 
     RowBox[{
      SuperscriptBox["\[Omega]", "2"], 
      SuperscriptBox["\[Gamma]", "2"]}]}]]}], ";"}]}], "Input",
 CellChangeTimes->{{3.7786009719983807`*^9, 3.778601082736413*^9}, {
