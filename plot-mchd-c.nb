Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cf0", "[", 
    RowBox[{"\[Omega]_", ",", "\[Gamma]_"}], "]"}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Omega]0", "[", 
        RowBox[{"[", "i", "]"}], "]"}], " ", 
       RowBox[{"g", "[", 
        RowBox[{"\[Omega]", ",", 
         RowBox[{"\[Omega]0", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "\[Gamma]"}], "]"}], "  ", 
       RowBox[{"cg", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}], " ", "-", " ", 
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], " ", 
       RowBox[{"g", "[", 
        RowBox[{"\[Omega]", ",", 
         RowBox[{"\[Omega]0", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", "\[Gamma]"}], "]"}], "  ", 
       RowBox[{"ca", "[", 
        RowBox[{"[", "i", "]"}], "]"}]}]}], " ", ")"}]}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cfg0", "[", 
    RowBox[{"\[Omega]_", ",", "\[Gamma]_"}], "]"}], " ", "=", " ", 
   RowBox[{
    UnderoverscriptBox["\[Sum]", 
     RowBox[{"i", "=", "1"}], "n"], 
    RowBox[{
     RowBox[{"\[Omega]0", "[", 
      RowBox[{"[", "i", "]"}], "]"}], " ", 
     RowBox[{"g", "[", 
      RowBox[{"\[Omega]", ",", 
       RowBox[{"\[Omega]0", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", "\[Gamma]"}], "]"}], "  ", 
     RowBox[{"cg", "[", 
      RowBox[{"[", "i", "]"}], "]"}]}]}]}], "  ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
