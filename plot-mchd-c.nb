 CellChangeTimes->{{3.7802257872957993`*^9, 3.78022578793369*^9}, {
  3.780225945189075*^9, 
  3.780225949953196*^9}},ExpressionUUID->"f5239f96-c33e-4a59-a38b-\
79199949a3f1"],

Cell["\<\
The following set of conversion factors should ideallybe the same, \
numerically, as those used in the code that calculates the MChD terms:\
\>", "Text",
 CellChangeTimes->{{3.780236265764638*^9, 3.780236306832953*^9}, {
  4.000220412840672*^9, 
  4.000220423791795*^9}},ExpressionUUID->"1a7cab56-b2b8-49a0-9cf5-\
30089a1fdada"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"au2cm", " ", "=", " ", "219474.6313702"}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"Hartree", " ", "to", " ", "inverse", " ", "cm"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cm2au", " ", "=", " ", 
    RowBox[{"1.", "/", "au2cm"}]}], ";"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"inverse", " ", "cm", " ", "to", " ", "Hartree"}], " ", "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"clight", " ", "=", "137.035999139"}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
   "speed", " ", "of", " ", "light", " ", "in", " ", "atomic", " ", "units"}],
    " ", "*)"}]}]}], "Input",
 CellChangeTimes->{{3.78023588375499*^9, 3.780235934796846*^9}},
 CellLabel->"In[10]:=",ExpressionUUID->"9b29d1d7-5ac3-4ef7-8aee-4640863b1acc"],

Cell[TextData[{
 "The term",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[Omega]", "j"], " ", "g", " ", 
     FractionBox[
      RowBox[{"C", "(", "G", ")"}], 
      RowBox[{"k", " ", "T"}]]}]}], TraditionalForm]],ExpressionUUID->
  "bf4ccc61-1046-4c82-98d4-838f88f49938"],
 " in atomic units corresponds to ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["e", "3"], 
     SubsuperscriptBox["a", "0", "5"]}], "\[HBar]"], TraditionalForm]],
  ExpressionUUID->"dc44c4ab-e02a-4b2e-a63e-8590487a0f14"],
 " . We convert to SI by expressing this factor in SI.\n\
We\[CloseCurlyQuote]ll get the values of the fundamental constants out of \
Mathematica\[CloseCurlyQuote]s curated data for physical constants:"
}], "Text",
 CellChangeTimes->{{3.780225025383567*^9, 3.780225087615773*^9}, {
  3.780225122277495*^9, 3.780225124109399*^9}, {3.780225631448917*^9, 
  3.780225647535036*^9}, {3.78023594233287*^9, 3.780236019396682*^9}, {
  3.780236312947296*^9, 
  3.7802363140032682`*^9}},ExpressionUUID->"70863b28-f0f7-40fb-a158-\
9184e275f37e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"hbar", " ", "=", " ", 
   RowBox[{
    RowBox[{"QuantityMagnitude", "[", 
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{"Quantity", "[", 
        RowBox[{"1", ",", "\"\<PlanckConstant\>\""}], "]"}], 
       ",", "\"\<SIBase\>\""}], "]"}], "]"}], " ", "/", " ", 
    RowBox[{"(", 
     RowBox[{"2", " ", "\[Pi]"}], ")"}]}]}], " ", ";", " ", 
  RowBox[{"hbar", " ", "//", "N"}]}]], "Input",
 CellChangeTimes->{{3.780225286741868*^9, 3.7802253147690153`*^9}, {
  3.7802254715268*^9, 3.780225601159286*^9}, {3.780225664433044*^9, 
  3.780225666738895*^9}},
 CellLabel->"In[13]:=",ExpressionUUID->"af585adf-b15b-4c79-8ba2-d204a66d831b"],

