Cell[BoxData[
 RowBox[{
  RowBox[{"cau", " ", "=", " ", 
   RowBox[{"1", "/", 
    RowBox[{"QuantityMagnitude", "[", 
     RowBox[{"UnitConvert", "[", 
      RowBox[{
       RowBox[{"Quantity", "[", 
        RowBox[{"1", ",", "\"\<FineStructureConstant\>\""}], "]"}], 
       ",", "\"\<SIBase\>\""}], "]"}], "]"}]}]}], ";", " ", 
  RowBox[{"cau", "  ", "//", "N"}]}]], "Input",
 CellChangeTimes->{{3.894986185609626*^9, 3.894986212703157*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"78b5897a-1319-4e01-ac0b-df1a1133069c"],

Cell[TextData[{
 "Assemble the conversion factor  ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{
     SuperscriptBox["e", "3"], 
     SubsuperscriptBox["a", "0", "5"]}], "\[HBar]"], TraditionalForm]],
  ExpressionUUID->"a114f4bd-a905-45e5-af1f-ea89fe7d01ca"],
 " for the units of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "j"], " ", "g", " ", 
    FractionBox[
     RowBox[{"C", "(", "G", ")"}], 
     RowBox[{"k", " ", "T"}]]}], TraditionalForm]],ExpressionUUID->
  "f2ca153f-ae13-48df-96bb-e84d11348591"],
 " from au to SI, \nmultiply with the numerical value of ",
 Cell[BoxData[
  FormBox[
   FractionBox[
    RowBox[{"2", " ", 
     SubscriptBox["\[Mu]", "0"], "c", " ", "N", " ", 
     SubscriptBox["B", "z"]}], 
    RowBox[{"3", "\[HBar]"}]], TraditionalForm]],ExpressionUUID->
  "9f79d229-8f42-491b-8949-7e4611981fcb"],
 " in SI for 1 Tesla of field and 1 molecule per cubic meter, \nand multiply \
it by 1000 times the Avogadro number, to get a result for one mol of \
molecules per liter and per Tesla of B-field"
}], "Text",
 CellChangeTimes->{{3.780247397293645*^9, 3.7802474190965557`*^9}, {
  3.780247572617202*^9, 3.780247594283183*^9}, {3.780308974075068*^9, 
  3.7803089895372677`*^9}, {3.780312609129047*^9, 3.780312687985487*^9}, {
  3.7803293122278433`*^9, 
