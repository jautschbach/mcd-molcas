Notebook[{

Cell[CellGroupData[{
Cell["MChD C-term spectra", "Section",
 CellChangeTimes->{{3.778608318061652*^9, 
  3.7786083231715918`*^9}},ExpressionUUID->"627b795c-f9fb-4e3e-aecb-\
2cd67f4ad616"],

Cell[TextData[{
 "Literature: L. Barron, Molecular Light Scattering and Optical Activity, 2nd \
edition, Cambridge, 2004.\n\nWe create the MChD according to Barron\
\[CloseCurlyQuote]s Equation (6.4.2b), page 328\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SuperscriptBox["n", 
      RowBox[{"'", "\[UpArrow]", "\[UpArrow]"}]], " ", "-", " ", 
     SuperscriptBox["n", 
      RowBox[{"'", "\[UpArrow]", "\[DownArrow]"}]]}], " ", "=", " ", 
    RowBox[{
     FractionBox[
      RowBox[{"2", " ", 
       SubscriptBox["\[Mu]", "0"], "c", " ", "N", " ", 
       SubscriptBox["B", "z"]}], 
      RowBox[{"3", "\[HBar]"}]], 
     RowBox[{"(", " ", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Omega]", "j"], " ", "g", " ", 
        FractionBox[
         RowBox[{"C", "(", "G", ")"}], 
         RowBox[{"k", " ", "T"}]]}], " ", "-", " ", 
       RowBox[{"\[Omega]", " ", "g", " ", 
        FractionBox[
         RowBox[{"C", "(", 
          RowBox[{"A", "'"}], ")"}], 
         RowBox[{"k", " ", "T"}]]}]}], ")"}]}]}], TraditionalForm]],
  ExpressionUUID->"54b3e5e4-f5de-452d-aae5-a9248c8d16c2"],
 "\n\nWe have an external code that produces a list of excitation \
wavenumbers, and the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", "G", ")"}], TraditionalForm]],ExpressionUUID->
  "65264f1f-cc93-4e7e-9c8d-f1d09f23d09d"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{"A", "'"}], ")"}], TraditionalForm]],ExpressionUUID->
  "7a28fbdd-06e0-43b8-9b70-864a9f5f73f4"],
 " quantities ",
 StyleBox["divided by kT",
  FontWeight->"Bold",
  FontSlant->"Italic"],
 ", all in atomic units.\nNote that the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{"A", "'"}], ")"}], TraditionalForm]],ExpressionUUID->
  "76d359ce-f35b-4ebf-b3cf-f625b2a82856"],
 " terms on input do not contain the factor of \[Omega], so we have to add \
that factor in atomic units when generating the spectrum. This means that \
there will be a factor ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "g"}], TraditionalForm]],ExpressionUUID->
  "5b5d4a66-251f-4d44-944c-769d430dc815"],
 " in front of the ",
 Cell[BoxData[
  FormBox[
   RowBox[{"C", "(", 
    RowBox[{"A", "'"}], ")"}], TraditionalForm]],ExpressionUUID->
  "5b0719cb-7312-4c77-9186-bb37ee5c84c8"],
 " term in the relevant code below.\n\nTo re-state the same, we create ",
 Cell[BoxData[
  FormBox[
   RowBox[{"  ", 
    FractionBox[
     RowBox[{"C", "(", "G", ")"}], 
     RowBox[{"k", " ", "T"}]]}], TraditionalForm]],ExpressionUUID->
  "0a134241-4adc-44a9-9f0d-2ad6856030fc"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SuperscriptBox["\[Omega]", 
      RowBox[{"-", "1"}]], 
     FractionBox[
      RowBox[{"C", "(", 
       RowBox[{"A", "'"}], ")"}], 
      RowBox[{"k", " ", "T"}]]}]}], TraditionalForm]],ExpressionUUID->
  "82fd210d-5f44-4645-b16a-5623bfff860f"],
 " in atomic units in the external code, multiply in this notebook with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Omega]", "j"], " ", "g"}], TraditionalForm]],
  ExpressionUUID->"7021e3ea-5c33-417e-affc-65333ad7c347"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[Omega]", "2"], "g"}], TraditionalForm]],ExpressionUUID->
  "b868be0c-c8c5-4f19-9701-9873a06f4da8"],
 ", respectively,  in atomic units, then convert to SI as described below \
under Units and Conversion Factors. \n\nIn the equation above, \n",
 Cell[BoxData[
  FormBox[
   RowBox[{"g", " ", "=", " ", 
    FractionBox[
     RowBox[{"\[Omega]", " ", "\[Gamma]"}], 
     RowBox[{
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox[
          SubscriptBox["\[Omega]", "j"], "2"], "-", 
         SuperscriptBox["\[Omega]", "2"]}], ")"}], "2"], "+", 
      RowBox[{
       SuperscriptBox["\[Omega]", "2"], 
       SuperscriptBox["\[Gamma]", "2"]}]}]], " "}], TraditionalForm]],
  ExpressionUUID->"eaf08c5a-db72-4310-8e94-ba32aed4cccf"],
 "\nis Barron\[CloseCurlyQuote]s absorption line shape function from pg. 96, \
with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Omega]", "j"], TraditionalForm]],ExpressionUUID->
  "8feb777d-435c-4359-acab-6679189d9387"],
 "being the frequency of excitation no. ",
 Cell[BoxData[
  FormBox["j", TraditionalForm]],ExpressionUUID->
  "0e1c9a8a-2bc1-44eb-af76-da750f937804"],
 ". We may also use normalized Gaussian functions, for example, if the \
Lorentzian-like line shape from Barron turns out to be too wide at its base.\n\
\nIn order to skip lines starting with \[OpenCurlyQuote]#\[CloseCurlyQuote] \
in the data files we have used some code  from \
https://mathematica.stackexchange.com/questions/50718/skip-header-lines-on-\
import"
}], "Text",
 CellChangeTimes->{{3.778608327493614*^9, 3.77860841859931*^9}, {
   3.778608511624934*^9, 3.778608545131343*^9}, {3.778608584338957*^9, 
   3.778608605432971*^9}, {3.778609023106518*^9, 3.7786090449268913`*^9}, {
   3.778678210026787*^9, 3.778678220872604*^9}, {3.778680037126889*^9, 
   3.778680044217431*^9}, {3.7786800914087057`*^9, 3.778680155773314*^9}, {
   3.778680358680003*^9, 3.7786803938225393`*^9}, {3.778680566971916*^9, 
   3.778680634030734*^9}, {3.7788567611283293`*^9, 3.778856896421351*^9}, {
   3.77885693289501*^9, 3.778857004778728*^9}, {3.7788570431796827`*^9, 
   3.778857095252593*^9}, {3.778857131734771*^9, 3.778857132192404*^9}, {
   3.7788571886446133`*^9, 3.778857516020359*^9}, {3.780244503824891*^9, 
   3.780244551852113*^9}, {3.7803201322569647`*^9, 3.7803202699443913`*^9}, {
   3.780320307308188*^9, 3.7803203389478693`*^9}, {3.782490188091865*^9, 
   3.7824901897436647`*^9}, {3.78249022515692*^9, 3.782490279075549*^9}, 
   3.999957271643323*^9},ExpressionUUID->"47b1ab3c-8563-4f74-a455-\
4d45f160d200"],

